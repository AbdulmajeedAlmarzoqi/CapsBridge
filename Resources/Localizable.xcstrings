    },
    "Remove CapsBridge…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة CapsBridge…"
          }
        }
      }
    },
    "Removing the helper from this Mac…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إزالة المساعد من الماك…"
          }
        }
      }
    },
    "Report a Problem" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإبلاغ عن مشكلة"
          }
        }
      }
    },
    "Report copied" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُسخ التقرير"
          }
        }
      }
    },
    "Restart Now" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد التشغيل الآن"
          }
        }
      }
    },
    "Restart Windows" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تشغيل ويندوز"
          }
        }
      }
    },
    "Restart Windows now?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تعيد تشغيل ويندوز الآن؟"
          }
        }
      }
    },
