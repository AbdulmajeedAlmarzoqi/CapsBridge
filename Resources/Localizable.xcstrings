    "Start Windows to clean it up?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تشغّل ويندوز لتنظيفه؟"
          }
        }
      }
    },
    "Start Windows to finish" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
