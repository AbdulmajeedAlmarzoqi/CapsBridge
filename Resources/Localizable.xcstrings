{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is not running" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ لا يعمل حاليًا"
          }
        }
      }
    },
    "%@ is not running. CapsBridge can start it to remove the Caps Lock mapping, or leave Windows unchanged. The mapping has no effect without CapsBridge." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ لا يعمل حاليًا. يمكن لـ CapsBridge تشغيله لإزالة تعيين مفتاح Caps Lock، أو ترك Windows دون تغيير، إذ لا أثر للتعيين من دون CapsBridge."
          }
        }
      }
    },
    "%@ is running" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ قيد التشغيل"
          }
        }
      }
    },
    "%@ is running, but “Allow agent control of this VM” is turned off in VMPal" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ قيد التشغيل، لكن الخيار “Allow agent control of this VM” متوقف في VMPal"
          }
        }
      }
    },
    "%@ is starting up or waiting for a user to sign in" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ قيد البدء أو بانتظار تسجيل دخول المستخدم"
          }
        }
      }
    },
    "%@ was left unchanged. The remaining Caps Lock mapping has no effect without CapsBridge." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرك %@ دون تغيير. ولا أثر لتعيين مفتاح Caps Lock المتبقي من دون CapsBridge."
          }
        }
      }
    },
    "Allow CapsBridge to configure Windows?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد السماح لـ CapsBridge بإعداد Windows؟"
          }
        }
      }
    },
    "An earlier version is running" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل إصدار أقدم"
          }
        }
      }
    },
    "An operation in Windows failed. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إكمال عملية في Windows. %@"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء"
          }
        }
      }
    },
    "Cannot be verified right now" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر التحقق منه حاليًا"
          }
        }
      }
    },
    "Caps Lock in Windows" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح Caps Lock في Windows"
          }
        }
      }
    },
    "Caps Lock is an NVDA modifier key" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح Caps Lock مفعّل مفتاحَ تعديل في NVDA"
          }
        }
      }
    },
    "Caps Lock is not yet an NVDA modifier key" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح Caps Lock غير مفعّل بعدُ مفتاحَ تعديل في NVDA"
          }
        }
      }
    },
    "Caps Lock is ready to use" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح Caps Lock جاهز للاستخدام"
          }
        }
      }
    },
    "Caps Lock returns to its usual behavior in Windows after the next restart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعود مفتاح Caps Lock إلى سلوكه المعتاد في Windows بعد إعادة التشغيل القادمة."
          }
        }
      }
    },
    "CapsBridge" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CapsBridge"
          }
        }
      }
    },
    "CapsBridge Helper" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساعد CapsBridge"
          }
        }
      }
    },
    "CapsBridge Helper is turned off" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساعد CapsBridge متوقف"
          }
        }
      }
    },
    "CapsBridge Website" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقع CapsBridge"
          }
        }
      }
    },
    "CapsBridge could not be moved to the Applications folder. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر نقل CapsBridge إلى مجلد التطبيقات. %@"
          }
        }
      }
    },
    "CapsBridge has been removed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إزالة CapsBridge"
          }
        }
      }
    },
    "CapsBridge is not set up" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إعداد CapsBridge"
          }
        }
      }
    },
    "CapsBridge requires VMPal and a Windows virtual machine. Install VMPal, create a Windows virtual machine, and then open CapsBridge again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب CapsBridge تطبيق VMPal وجهاز Windows افتراضيًا. ثبّت VMPal وأنشئ جهاز Windows افتراضيًا، ثم افتح CapsBridge مرة أخرى."
          }
        }
      }
    },
    "CapsBridge runs a helper from within the app, so the app must remain in the Applications folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل CapsBridge مساعدًا من داخل التطبيق، لذا يجب أن يبقى التطبيق في مجلد التطبيقات."
          }
        }
      }
    },
    "CapsBridge will quit when the current operation is complete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إنهاء CapsBridge عند اكتمال العملية الحالية."
          }
        }
      }
    },
    "Check Again" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحقق مرة أخرى"
          }
        }
      }
    },
    "Checking configuration…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التحقق من الإعداد…"
          }
        }
      }
    },
    "Click Fix to resolve the items that need attention." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على «إصلاح» لمعالجة العناصر التي تحتاج إلى ذلك."
          }
        }
      }
    },
    "Configured; cannot be verified right now" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُعَدّ، ويتعذّر التحقق منه حاليًا"
          }
        }
      }
    },
    "Configured; takes effect after Windows restarts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُعَدّ، ويسري بعد إعادة تشغيل Windows"
          }
        }
      }
    },
    "Configured; takes effect the next time Windows starts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُعَدّ، ويسري عند تشغيل Windows في المرة القادمة"
          }
        }
      }
    },
    "Configured; verified when Windows is running" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُعَدّ، ويُتحقَّق منه عندما يكون Windows قيد التشغيل"
          }
        }
      }
    },
    "Configuring Caps Lock in Windows…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إعداد مفتاح Caps Lock في Windows…"
          }
        }
      }
    },
    "Copy Diagnostic Report" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ تقرير التشخيص"
          }
        }
      }
    },
    "Create a Windows virtual machine in VMPal, and then check again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ جهاز Windows افتراضيًا في VMPal، ثم تحقّق مرة أخرى."
          }
        }
      }
    },
    "Diagnostic report copied" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نسخ تقرير التشخيص"
          }
        }
      }
    },
    "Do you also want to move CapsBridge to the Trash?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد أيضًا نقل CapsBridge إلى سلة المهملات؟"
          }
        }
      }
    },
    "Don’t Move" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدم النقل"
          }
        }
      }
    },
    "Fix" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصلاح"
          }
        }
      }
    },
    "Get VMPal" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحصول على VMPal"
          }
        }
      }
    },
    "In Windows, hold Caps Lock as the screen reader modifier key. To turn Caps Lock on or off, press it twice quickly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Windows، اضغط مع الاستمرار على Caps Lock لاستخدامه مفتاحَ تعديل لقارئ الشاشة. ولتشغيل Caps Lock أو إيقافه، اضغطه مرتين بسرعة."
          }
        }
      }
    },
    "Installed (version %@)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبّت (الإصدار %@)"
          }
        }
      }
    },
    "Installing the helper…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تثبيت المساعد…"
          }
        }
      }
    },
    "Keep" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إبقاء"
          }
        }
      }
    },
    "Later" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحقًا"
          }
        }
