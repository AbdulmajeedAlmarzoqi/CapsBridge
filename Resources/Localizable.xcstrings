    },
    "Leave Unchanged" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترك دون تغيير"
          }
        }
      }
    },
    "Make sure VMPal is running, and then check again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكّد من أن VMPal قيد التشغيل، ثم تحقّق مرة أخرى."
          }
        }
      }
    },
    "Missing. Windows may have been reset or restored from a snapshot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفقود. ربما أُعيد ضبط Windows أو استُعيد من لقطة سابقة."
          }
        }
      }
    },
    "Move CapsBridge to the Applications folder?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد نقل CapsBridge إلى مجلد التطبيقات؟"
          }
        }
      }
    },
    "Move to Applications Folder" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل إلى مجلد التطبيقات"
          }
        }
      }
    },
    "Move to Trash" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل إلى سلة المهملات"
          }
        }
      }
    },
    "NVDA" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVDA"
          }
        }
      }
    },
    "NVDA could not be restarted. To start NVDA, press Control-Alt-N in Windows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة تشغيل NVDA. لتشغيل NVDA، اضغط Control-Alt-N في Windows."
          }
        }
      }
    },
    "NVDA did not quit, so its settings were not changed. Quit NVDA in Windows, and then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم إنهاء NVDA، لذا لم تُغيَّر إعداداته. أنهِ NVDA في Windows، ثم حاول مرة أخرى."
          }
        }
      }
    },
    "Needs attention" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج إلى معالجة"
